{
  "builds": [{ "src": "cmps350-project/package.json", "use": "@vercel/next" }],
  "routes": [
    { "src": "^/favicon.ico$", "dest": "/cmps350-project/public/file.svg" },
    {
      "src": "^/_next/static/(.*)$",
      "dest": "/cmps350-project/.next/static/$1"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/cmps350-project/api/$1"
    },
    { "src": "^/(.*)$", "dest": "/cmps350-project/$1" }
  ]
}

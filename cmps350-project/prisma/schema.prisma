// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model student {
  id Int @id
}

model course {
  id               Int       @id @default(autoincrement())
  code             String
  name             String
  credits          Int
  prerequisites    course[]
  description      String
  registrationOpen Boolean
  sections         section[]
  course           course?   @relation(fields: [courseId], references: [id])
  courseId         Int?
}

model instructor {
  section section[]
}

model section {
  crn        Int        @id @default(autoincrement())
  instructor instructor @relation(fields: [], references: [])
  course     course?    @relation(fields: [courseId], references: [id])
  courseId   Int?
}

